# Copy to .env and point secret paths at root-readable files that are NOT in Git.
# See secrets/README.md.

LISTEN_ADDR=0.0.0.0:8080
RELAY_ORIGIN=https://relay.pseud0.org
MATRIX_HOMESERVER=https://matrix.pseud0.org
MATRIX_USER_ID=@web-login:pseud0.org
MATRIX_ENABLED=true

DATABASE_URL=postgres://relay:change-me@127.0.0.1:5432/relay
DATABASE_URL_FILE=

CRYPTO_STORE_PATH=./relay/crypto-store
DATA_PATH=./relay/data

RELAY_SIGNING_KID=relay-2026-01
SUBJECT_KEY_VERSION=1

RELAY_MATRIX_ACCESS_TOKEN_FILE=./secrets/relay_matrix_access_token
RELAY_MATRIX_DEVICE_ID_FILE=./secrets/relay_matrix_device_id
RELAY_CRYPTO_PASSPHRASE_FILE=./secrets/relay_crypto_passphrase
RELAY_SIGNING_KEY_FILE=./secrets/relay_signing_key
RELAY_SUBJECT_KEY_FILE=./secrets/relay_subject_key_v1
RELAY_AT_REST_KEY_FILE=./secrets/relay_at_rest_key
RELAY_LOOKUP_PEPPER_FILE=./secrets/relay_lookup_pepper

RUST_LOG=pseud0_web_login_relay=info,tower_http=info
